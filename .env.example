# Copy to .env and fill in. Never put real values in this file; it is committed.

# Slack — from the Slack app's settings (OAuth & Permissions, Basic Information).
# Each workspace the bot is installed in has its own token and channel IDs.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional, left commented because an empty value is read as "" rather than unset.
# IANA timezone used when a channel has none stored. Default: Asia/Bangkok
# SLACK_TIMEZONE=Asia/Bangkok
# Per-channel daily window used when Firestore has none. Default: 09:00–10:00
# SLACK_DAILY_TIME_RANGES={"C0123ABCD":{"startTime":"09:00","endTime":"10:00"}}

# Resource requests (/request-resource, /borrowed)
# Required for this feature. Channel the request cards are posted to, e.g. C0123ABCD.
# The bot must be a member.
RESOURCE_REQUEST_CHANNEL_ID=
# Optional. Comma-separated Slack user IDs who may decide any request, e.g. U01AAA,U02BBB
RESOURCE_REQUEST_ADMIN_IDS=
# Optional. Comma-separated project names for the form's dropdown. Empty = free text.
RESOURCE_REQUEST_PROJECTS=

# Firebase Admin (server only) — from a service account key in Firebase console.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap in double quotes and keep the \n escapes as in the key file:
# "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK (public browser configuration). Inlined at build time,
# so a change needs a rebuild/redeploy. scripts/setup-firebase-google-auth.sh
# writes these to .env.local.
NEXT_FIREBASE_API_KEY=
NEXT_FIREBASE_AUTH_DOMAIN=
NEXT_FIREBASE_PROJECT_ID=
NEXT_FIREBASE_STORAGE_BUCKET=
NEXT_FIREBASE_MESSAGING_SENDER_ID=
NEXT_FIREBASE_APP_ID=
NEXT_FIREBASE_MEASUREMENT_ID=
NEXT_FIREBASE_ALLOWED_EMAIL_DOMAIN=sennalabs.com
